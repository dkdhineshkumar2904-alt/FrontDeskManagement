# ==============================================================================
# Freshdesk MCP Connector - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and provide your actual Freshdesk credentials.
# NEVER commit your actual .env file or API keys to version control.
# ==============================================================================

# Freshdesk domain name or URL
# Examples: "mycompany" or "mycompany.freshdesk.com" or "https://mycompany.freshdesk.com"
# The connector normalizes any of these into: https://<domain>.freshdesk.com/api/v2
FRESHDESK_DOMAIN=your-subdomain

# Freshdesk API Key (found in Freshdesk: Profile Settings -> View API Key)
# Minimum required permission: Agent with read-only view access to tickets
FRESHDESK_API_KEY=your_freshdesk_api_key_here

# Network timeout for Freshdesk HTTP API requests in seconds (default: 15.0)
FRESHDESK_TIMEOUT=15.0

# Maximum retry attempts for transient errors (HTTP 429, 500, 502, 503, 504, network timeouts)
FRESHDESK_MAX_RETRIES=3

# Maximum pagination pages the connector is allowed to traverse per tool call (safety ceiling)
FRESHDESK_MAX_PAGES=5

# Maximum concurrent requests permitted to the Freshdesk API
FRESHDESK_CONCURRENCY_LIMIT=5

# MCP Server Transport: "stdio" (local MCP client) or "streamable-http" (remote/HTTP client)
MCP_TRANSPORT=stdio

# Streamable HTTP Transport Settings (only used when MCP_TRANSPORT=streamable-http)
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_PATH=/mcp

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Maximum text length (in characters) before sanitization truncates ticket body/description
MAX_TEXT_LENGTH=4000
